<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="190dp" android:orientation="vertical" android:padding="22dp" android:background="@drawable/bg_header">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="CAMPUS COMPANION" android:textColor="#E9E9FF" android:textSize="12sp" android:textStyle="bold"/><com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/switchDarkMode" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark" android:textColor="@color/white"/></LinearLayout>
<TextView android:id="@+id/tvWelcome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your campus, organized." android:textSize="29sp" android:textStyle="bold" android:textColor="@color/white" android:layout_marginTop="25dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Track academics, deadlines, classes and campus essentials." android:textSize="14sp" android:textColor="#E9E9FF" android:layout_marginTop="6dp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today at a glance" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp"><LinearLayout android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Attendance" android:textColor="@color/text_secondary"/><TextView android:id="@+id/tvAttendance" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No data" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/primary" android:layout_marginTop="8dp"/></LinearLayout><Space android:layout_width="10dp" android:layout_height="1dp"/><LinearLayout android:layout_width="0dp" android:layout_height="100dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:background="@drawable/bg_card"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pending tasks" android:textColor="@color/text_secondary"/><TextView android:id="@+id/tvTasks" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textSize="25sp" android:textStyle="bold" android:textColor="@color/accent" android:layout_marginTop="8dp"/></LinearLayout></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="10dp" android:background="@drawable/bg_card"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Next class today" android:textColor="@color/text_secondary"/><TextView android:id="@+id/tvNextClass" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No class added for today" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="7dp"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Quick actions" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="22dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp"><Button android:id="@+id/actionAcademics" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Academics"/><Space android:layout_width="8dp" android:layout_height="1dp"/><Button android:id="@+id/actionWeather" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Weather"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="8dp"><Button android:id="@+id/actionCampus" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Campus Map"/><Space android:layout_width="8dp" android:layout_height="1dp"/><Button android:id="@+id/actionFocus" android:layout_width="0dp" android:layout_height="52dp" android:layout_weight="1" android:text="Start Focus"/></LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Upcoming tasks" android:textSize="20sp" android:textStyle="bold" android:textColor="@color/text_primary" android:layout_marginTop="22dp"/><TextView android:id="@+id/tvTaskList" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="No pending tasks. Add one from Academics." android:textSize="14sp" android:textColor="@color/text_secondary" android:lineSpacingExtra="6dp" android:paddingTop="10dp" android:paddingBottom="20dp"/>
</LinearLayout></LinearLayout></ScrollView>